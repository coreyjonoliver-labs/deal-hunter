{
  "version": 1,
  "project": {
    "name": "deal-hunter",
    "tagline": "Watch Facebook Marketplace for what you want, rated by AI.",
    "type": "CLI + service",
    "primaryLanguage": "Python"
  },
  "commands": {
    "test": "uv run pytest -q",
